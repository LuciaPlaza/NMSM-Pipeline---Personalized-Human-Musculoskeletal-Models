				<JMPJointSet>
					<!--
					  Elbow/forearm/wrist axis personalization as a dedicated
					  final step, exactly mirroring how ankle_r/l were treated
					  in Step 4: run AFTER all body scaling and marker
					  repositioning is complete (Steps 5-7), with zero
					  competing body parameters and bounds tightened to
					  0.15 rad (same value validated for ankle in Step 4),
					  since at this stage only fine correction is expected,
					  not a fresh search.

					  Note: there is no marker distal to the wrist (no hand
					  marker in this dataset), so radius_hand orientation has
					  weaker corrective leverage than elbow/radioulnar; it
					  is included as a safety net (as Step 4 was for SUBJ1,
					  where it converged with zero gradient) and may simply
					  converge immediately for this subject too.
					-->
					<JMPJoint name="elbow_r">
						<parent_frame_transformation>
							<translation>false false false</translation>
							<orientation>true true false</orientation>
							<translation_bounds>0.0</translation_bounds>
							<orientation_bounds>0.25</orientation_bounds>
						</parent_frame_transformation>
